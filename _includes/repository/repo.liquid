{% assign repo_url = include.repository.repo | split: '/' %}
{% if site.data.repositories.github_users contains repo_url.first %}
  {% assign show_owner = false %}
{% else %}
  {% assign show_owner = true %}
{% endif %}

<a class="repo-item" href="https://github.com/{{ include.repository.repo }}">
  <span class="repo-name">
    {% if show_owner %}{{ repo_url[0] }}/{% endif %}{{ repo_url[1] }}
  </span>
  {% if include.repository.description %}
    <span class="repo-desc">{{ include.repository.description }}</span>
  {% endif %}
  {% if include.repository.language %}
    <span class="repo-lang">{{ include.repository.language }}</span>
  {% endif %}
</a>
