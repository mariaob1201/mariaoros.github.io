<div class="repo-user">
  <a class="repo-user-name" href="https://github.com/{{ include.username }}">@{{ include.username }}</a>
  {% if site.github_profile_views.enabled %}
    <img
      class="repo-user-views"
      alt="GitHub profile views"
      src="{{ site.github_profile_views.url }}/?username={{ include.username }}&label=profile+views&color=808080&style=flat-square"
    >
  {% endif %}
</div>
